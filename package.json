{
  "name": "@adrianchan94/muscle-memory",
  "version": "1.0.0-rc.3",
  "description": "Verifier-gated procedural memory for Letta agents: prescribe one matching skill or abstain, measure the next possession, and keep only skills that earn their context.",
  "author": "Adrian Chan <@adrianchan94>",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "muscle-memory",
    "agent-skills",
    "skill-ops",
    "procedural-memory",
    "verifier-gated",
    "skill-distillation",
    "self-improving-agents",
    "letta-code",
    "letta-mod",
    "complementary-learning-systems",
    "decision-report",
    "helped-scoreboard",
    "act-time-governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianchan94/muscle-memory.git"
  },
  "files": [
    "MOD.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "mods"
  ],
  "scripts": {
    "test": "MM_TEST_ROOT=$(mktemp -d) && MM_STATE_DIR=\"$MM_TEST_ROOT/state\" MEMORY_DIR=\"$MM_TEST_ROOT/memory\" MM_GLOBAL_SKILLS_DIR=\"$MM_TEST_ROOT/global-skills\" bun test --max-concurrency=1 test/",
    "build": "bun build mods/index.ts --target node --outfile mods/index.bundled.mjs",
    "transpile": "bun build mods/index.ts --target node --outfile /tmp/muscle-memory.build.js",
    "prepublishOnly": "npm run build",
    "eval:routing": "bun test/routing.eval.ts",
    "dogfood:claims": "bun test scripts/claim-experience.test.ts",
    "smoke:live": "node scripts/live-smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "final:gate": "node scripts/final-gate.mjs",
    "verify": "npm run build && npm run test && npm run eval:routing && npm run smoke:live && npm run package:smoke"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "letta": {
    "manifestVersion": 1,
    "mods": [
      "./mods/index.bundled.mjs"
    ],
    "capabilities": [
      "tools",
      "commands",
      "events.tools",
      "events.lifecycle",
      "events.llm",
      "events.compact",
      "events.turns",
      "ui.panels",
      "permissions"
    ],
    "engines": {
      "lettaCodeCli": ">=0.27.18"
    }
  },
  "contributors": [
    {
      "name": "Kev (Constellation agent)",
      "url": "https://github.com/adrianchan94"
    },
    {
      "name": "Mack (local Letta agent)",
      "url": "https://github.com/adrianchan94"
    }
  ],
  "homepage": "https://muscle-memory-v1-research.vercel.app/",
  "bugs": {
    "url": "https://github.com/adrianchan94/muscle-memory/issues"
  }
}
